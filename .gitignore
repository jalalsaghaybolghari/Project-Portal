node_modules/
dist/
.angular/
.nx/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Environment-specific frontend files
.env
.env.*
!.env.example

# ==========================================
# Secrets and local configuration
# ==========================================

# Environment variables
.env
.env.*
!.env.example

# Local secret/configuration files
secrets.json
appsettings.*.local.json
*.local.json

# Certificates and private keys
*.pfx
*.p12
*.key
*.pem

# Never commit files containing real credentials.
# Keep appsettings.json only when it contains no secrets.

