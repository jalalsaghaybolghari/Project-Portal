# ==========================================

.vs/
.idea/
*.sln.iml

# Ignore personal VS Code settings but keep shared configuration
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# ==========================================
# Node.js / Angular (future frontend)
